{
  "name": "@cachestorm/client",
  "version": "0.1.27",
  "description": "Official TypeScript client for CacheStorm - High-Performance Redis-Compatible Database",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test --test-force-exit --test-timeout=10000 build-test/test/resp.test.js build-test/test/client.test.js build-test/test/connection.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cachestorm",
    "redis",
    "cache",
    "database",
    "typescript"
  ],
  "author": "CacheStorm Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {},
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.14"
  }
}
